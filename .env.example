# ============ Runtime profile ============
# mvp  : chạy offline hoàn toàn (Qdrant in-memory, KG JSON, LLM/embedder stub)
# prod : Qdrant server + Neo4j + vLLM + model thật
APP_PROFILE=mvp
LOG_LEVEL=INFO

# ============ LLM (vLLM OpenAI-compatible endpoint) ============
LLM_BACKEND=stub                 # stub | openai_compatible
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=EMPTY
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

# ============ Embedding ============
EMBEDDING_BACKEND=stub           # stub | sentence_transformers
EMBEDDING_MODEL=darklethelong/vnlegal-lal
EMBEDDING_FALLBACK_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_DEVICE=cpu

# ============ Reranker ============
RERANKER_BACKEND=stub            # stub | flag_embedding
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ============ Qdrant ============
QDRANT_MODE=memory               # memory | server
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=vn_legal_chunks

# ============ Knowledge Graph ============
GRAPH_BACKEND=memory             # memory | neo4j
GRAPH_SNAPSHOT_PATH=data/processed/legal_graph.json
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# ============ Retrieval / Agent policy ============
RETRIEVAL_TOP_K_DENSE=20
RETRIEVAL_TOP_K_SPARSE=20
RRF_K=60
RERANK_TOP_N=8
MAX_RETRIEVAL_ATTEMPTS=2
GROUNDING_THRESHOLD=0.6
CLAIM_SUPPORT_THRESHOLD=0.6

# ============ Observability (Monitor) ============
ENABLE_RUN_LOG=true
RUN_LOG_PATH=data/processed/run_log.jsonl
# LangSmith tracing (tuỳ chọn) - LangGraph tự gửi trace khi bật đủ 3 biến này
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=legal-agent-vn

# ============ Evaluation ============
EVAL_DATASET_PATH=data/eval/golden_set.jsonl
EVAL_REPORT_DIR=data/processed/eval

# ============ Paths ============
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
BM25_INDEX_PATH=data/processed/bm25_index.pkl
